{
  "name": "siyuan-plugin-caldav-sync",
  "version": "0.2.33",
  "description": "Two-way sync calendar events and todos with CalDAV servers (Radicale / Nextcloud / Baikal). Month/Week/Day calendar views, task view, editor and daily note integration.",
  "repository": "https://github.com/vilifetime/siyuan-plugin-caldav-sync",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode dev",
    "build": "vite build && node scripts/make-package.mjs",
    "test": "npm run test:secret && npm run test:core && npm run test:chinacal && npm run test:reconcile && npm run test:synctoken && npm run test:storage && npm run test:loader && npm run test:mobile && npm run test:layout && npm run test:reminder && npm run test:toggle && npm run test:diary && npm run test:task && npm run test:tasksearch && npm run test:todoattach && npm run test:attachconfirm && npm run test:wktodo && npm run test:digest && npm run test:alldayoutlook && npm run test:todayviewpref && npm run test:icloudattach && npm run test:daventry && npm run test:purge && npm run test:purgeui && npm run test:listview && npm run test:syncindicator && npm run test:multiacc && npm run test:deffilter",
    "test:storage": "node test/storage.test.mjs",
    "test:loader": "node test/loader.test.mjs",
    "test:reminder": "node test/reminder.test.mjs",
    "test:toggle": "node test/toggle.test.mjs",
    "test:mobile": "node test/mobile.test.mjs",
    "test:layout": "node test/layout.test.mjs",
    "test:diary": "node test/diary.test.mjs",
    "test:task": "node test/task-bucket.test.mjs",
    "test:tasksearch": "node test/task-search.test.mjs",
    "test:ui": "node test/ui.test.mjs",
    "test:core": "node test/core.test.mjs",
    "test:chinacal": "node test/holiday-cn.test.mjs",
    "test:todoattach": "node test/todo-attach.cjs",
    "test:reconcile": "node test/reconcile.test.mjs",
    "test:synctoken": "node test/sync-token.test.mjs",
    "test:secret": "node test/secret.test.mjs",
    "test:e2e": "node test/e2e.test.mjs",
    "e2e:radicale": "node scripts/radicale.mjs",
    "test:attachconfirm": "node test/attach-confirm.mjs",
    "test:wktodo": "node test/wk-todo-block.test.mjs",
    "test:digest": "node test/digest.test.mjs",
    "test:alldayoutlook": "node test/allday-outlook.test.mjs",
    "test:todayviewpref": "node test/today-view-pref.test.mjs",
    "test:icloudattach": "node test/icloud-attach.cjs",
    "test:daventry": "node test/dav-entry.test.mjs",
    "test:purge": "node test/purge-switch.test.mjs",
    "test:listview": "node test/list-view.test.mjs",
    "test:purgeui": "node test/purge-ui.test.mjs",
    "test:syncindicator": "node test/sync-indicator.test.mjs",
    "test:multiacc": "node test/multi-account.test.mjs",
    "test:deffilter": "node test/default-filter.test.mjs"
  },
  "keywords": [
    "siyuan",
    "plugin",
    "caldav",
    "radicale",
    "calendar",
    "tasks"
  ],
  "author": "vilifetime",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "siyuan": "^1.2.7",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7"
  }
}
